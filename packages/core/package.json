{
  "name": "@caseattend/core",
  "version": "0.1.0",
  "description": "Browser-free teaching engine contract for CaseAttend",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesWeatherhead/CaseAttend.git",
    "directory": "packages/core"
  },
  "keywords": [
    "education",
    "headless",
    "sdk",
    "visual-reasoning",
    "vlm"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
