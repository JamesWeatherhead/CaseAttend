{
  "name": "@caseattend/react",
  "version": "0.1.0",
  "description": "Accessible React components for the CaseAttend teaching engine",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./styles.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "styles.css", "README.md", "LICENSE"],
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@caseattend/core": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18.3 <20"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesWeatherhead/CaseAttend.git",
    "directory": "packages/react"
  },
  "keywords": [
    "accessibility",
    "education",
    "react",
    "visual-reasoning",
    "vlm"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
