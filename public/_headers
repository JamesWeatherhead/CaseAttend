# Cloudflare Pages security headers (ported from the old vercel.json).
# Applied to every static asset response. connect-src allows the browser-direct
# BYOK call straight to OpenRouter. CaseAttend has no prompt or inference API.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://openrouter.ai; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Content-hashed build output (vite renames on every change) — cache a year, but
# NOT immutable: if an edge blip during a deploy poisons a cache entry, dropping
# immutable lets it self-heal on the next reload instead of sticking for a year.
/assets/*
  Cache-Control: public, max-age=31536000

# Case images live at stable paths — cache a week.
/images/*
  Cache-Control: public, max-age=604800

# Small library-only previews; teaching workspace assets stay under /images.
/thumbnails/library/*
  Cache-Control: public, max-age=604800

# Self-hosted OCR worker, WebAssembly, and language data. Paths are stable, so
# cache for one week and revalidate after deployments that update dependencies.
/vendor/*
  Cache-Control: public, max-age=604800
